{
  "name": "rayneo-air4pro-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Workspace designer and device console for RayNeo Air 4 Pro AR glasses",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "vite build --config vite.config.offline.ts && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "emit:companion": "vite-node scripts/emit-companion.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
